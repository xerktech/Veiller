{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "sourceMap": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "assets/*": ["./assets/*"],
      "@cloud/*": ["../cloud/packages/types/*"],
      "@assets/*": ["./assets/*"],
      "@plugins/*": ["./plugins/*"],
      "@veiller/bluetooth-sdk-internal": ["./modules/bluetooth-sdk/src/_internal"],
      "@veiller/cloud-client": ["../cloud-v2/packages/cloud-client/src/index.ts"],
      "@veiller/cloud-client/react-native": ["../cloud-v2/packages/cloud-client/react-native/index.ts"],
      "@veiller/cloud-runtime/protocol": ["../cloud-v2/packages/runtime/src/protocol/index.ts"],
      "@veiller/engine": ["./modules/engine/src/index.ts"],
      "@veiller/engine/*": ["./modules/engine/src/*"]
    },
    "types": ["node", "react", "jest", "bun-types"]
  },
  "extends": "expo/tsconfig.base",
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "test/**/*",
    "e2e-tests/ui/**/*",
    "modules/*/src/**/*.test.ts",
    "modules/*/src/**/__tests__/**/*",
    // Standalone module example apps have their own package.json / tooling and
    // must not be typechecked against the mobile app's dependency set (e.g. the
    // bluetooth-sdk example uses expo-media-library, which the app itself no
    // longer depends on — XERK-207).
    "modules/*/example/**/*"
  ]
}
